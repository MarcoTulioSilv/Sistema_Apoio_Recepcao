type = forbidden
source_modules = sar.web
forbidden_modules =
    sar.modulo_08_dados
    sqlalchemy
    pymysql

[importlinter:contract:banco]
name = Só o MOD-08 fala com o banco
type = forbidden
source_modules =
    sar.modulo_01_acesso
    sar.modulo_02_cadastro
    sar.modulo_03_operacao
    sar.modulo_04_documentos
    sar.modulo_05_emissao
    sar.modulo_06_configuracao
    sar.modulo_07_pendencias
    sar.modulo_09_agendamento
    sar.modulo_10_carga
    sar.modulo_11_titular
    sar.web
    sar.nucleo
forbidden_modules =
    sqlalchemy
    pymysql

[importlinter:contract:internet]
name = Só o cliente de CEP acessa a internet
type = forbidden
source_modules = sar
forbidden_modules =
    httpx
ignore_imports =
    sar.modulo_02_cadastro.cep -> httpx
# O cliente de CEP só existe a partir do Incremento 2; até lá a exceção acima não casa com nada.
# Voltar para "error" (o padrão) quando sar.modulo_02_cadastro.cep for criado.
unmatched_ignore_imports_alerting = warn
