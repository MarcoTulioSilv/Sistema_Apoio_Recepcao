# Fronteiras entre módulos do SAR, verificadas no pipeline (DDS_recepcao, DD-16 e §3.12).
# Rodar com: lint-imports
[importlinter]
root_package = sar
include_external_packages = True

[importlinter:contract:nucleo]
name = Núcleo não importa nenhum módulo
type = forbidden
source_modules = sar.nucleo
forbidden_modules =
    sar.modulo_01_acesso
    sar.modulo_02_cadastro
    sar.modulo_03_operacao
    sar.modulo_04_documentos
    sar.modulo_05_emissao
    sar.modulo_06_configuracao
    sar.modulo_07_pendencias
    sar.modulo_08_dados
    sar.modulo_09_agendamento
    sar.modulo_10_carga
    sar.modulo_11_titular
    sar.web
    sar.composicao

[importlinter:contract:dep_01]
name = MOD-01 só depende de MOD-08
