# Modelo de /etc/sar/backup.env (chmod 600, dono root). Valores do servidor, nunca segredos aqui.
RESTIC_REPOSITORY=/mnt/backup/sar-restic
RESTIC_PASSWORD_FILE=/etc/sar/restic.senha
SAR_COMPOSE=/opt/sar
SAR_COFRE_HOST=/srv/sar/cofre
SAR_DUMPS=/mnt/backup/dumps
SAR_CADDY_DADOS=/srv/sar/caddy
SAR_CONFIGURACAO=/etc/sar
SERVICO_MYSQL_SAR=mysql
